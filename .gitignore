# ==============================================================================
# HybridGuard — .gitignore
# Ensures zero API keys, App Check debug tokens, or build artifacts are committed
# ==============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# Environment variables & Secret Credentials (NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
*.env.local

# App Check Debug Tokens & Private Keys
*debug-token*
*.pem
*.key
serviceAccountKey.json
google-services.json

# Next.js Build Output & Turbopack Cache
.next/
/web/.next/
out/
/web/out/
.turbo/

# Extension Build Artifacts
extension/dist/
dist/

# Production & Packaging
build/

# Testing & Coverage
coverage/

# OS & Editor Metadata
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.tsbuildinfo
next-env.d.ts
