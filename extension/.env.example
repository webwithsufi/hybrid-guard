# ==============================================================================
# HybridGuard Chrome Extension — Environment Variables Template
# Copy this file to .env and populate with your Firebase project credentials.
# ==============================================================================

# Vite / Chrome Extension Firebase Configuration
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Firebase App Check Debug Token
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000
