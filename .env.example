# ==============================================================================
# HybridGuard — Master Environment Variables Template
# Built for #BuildHybridAI 2026 Hackathon
# ==============================================================================
# This repository contains two sub-projects:
#   1. /web        (Next.js 16 SaaS Dashboard)
#   2. /extension  (Chrome Manifest V3 Extension)
#
# Below are the shared Firebase credentials required by both projects.
# For /web, copy to web/.env.local
# For /extension, copy to extension/.env
# ==============================================================================

# Web Dashboard (/web/.env.local)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000

# Chrome Extension (/extension/.env)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000
